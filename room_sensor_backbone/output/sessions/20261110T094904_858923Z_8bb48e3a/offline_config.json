{
  "mode": "files",
  "input": {
    "path": "raw.jsonl",
    "format": "jsonl"
  },
  "selection": {
    "room": "laboratory",
    "sensor_id": "station-01",
    "metric": "temperature"
  },
  "calibration": {
    "enabled": true,
    "scale": 1.02,
    "offset": -0.4
  },
  "output": {
    "readings_path": "offline/calibrated.csv",
    "summary_path": "offline/summary.json"
  },
  "logging": {
    "level": "INFO",
    "path": "offline/analysis.log"
  }
}
